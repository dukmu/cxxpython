inline const NodeInfo &info(Kind kind) {
return node_info.at(static_cast<std::size_t>(kind));
}
inline std::optional<Kind> node_category(FieldType field) {
switch (field) {
case FieldType::mod: return Kind::mod;
case FieldType::stmt: return Kind::stmt;
case FieldType::expr: return Kind::expr;
case FieldType::expr_context: return Kind::expr_context;
case FieldType::boolop: return Kind::boolop;
case FieldType::operator_: return Kind::operator_;
case FieldType::unaryop: return Kind::unaryop;
case FieldType::cmpop: return Kind::cmpop;
case FieldType::comprehension: return Kind::comprehension;
case FieldType::excepthandler: return Kind::excepthandler;
case FieldType::arguments: return Kind::arguments;
case FieldType::arg: return Kind::arg;
case FieldType::keyword: return Kind::keyword;
case FieldType::alias: return Kind::alias;
case FieldType::withitem: return Kind::withitem;
case FieldType::match_case: return Kind::match_case;
case FieldType::pattern: return Kind::pattern;
case FieldType::type_ignore: return Kind::type_ignore;
case FieldType::type_param: return Kind::type_param;
default: return {};
}
