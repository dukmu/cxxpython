untokenize pairs '# coding: utf-8\r\n# comment\r\nif café :\r\n    π =(1 +\r\n    2 )# sum\r\n\r\n    pass \r\nlast =café '
pair roundtrip True
exact ('+', 'PLUS')
exact ('+=', 'PLUSEQUAL')
exact ('**', 'DOUBLESTAR')
exact ('**=', 'DOUBLESTAREQUAL')
exact ('...', 'ELLIPSIS')
exact (':=', 'COLONEQUAL')
exact ('->', 'RARROW')
exact ('@', 'AT')
exact ('!=', 'NOTEQUAL')
unknown exact True
